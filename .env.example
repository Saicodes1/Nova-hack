OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_MAIN=gpt-4.1-mini
NODE_MODE=local
NODE_URL=http://localhost:8100
LINK_MODE=demo-fast
STAC_PRIMARY=https://earth-search.aws.element84.com/v1
STAC_PRIMARY_COLLECTION=sentinel-2-c1-l2a
STAC_ARCHIVE_COLLECTION=sentinel-2-l2a
STAC_BACKUP=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_BACKUP_COLLECTION=sentinel-2-l2a
ANALYSES_DIR=var/analyses
SCENE_STORE=var/scenes
CACHE_DB=var/cache.sqlite
MAX_AOI_KM2=50
URBAN_MODEL_PATH=var/models/fresunet.onnx
# Flight node (Jetson): VERDICT_MODE=ollama words the verdict with a local model.
VERDICT_MODE=template
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Address phones use to reach the ground station (shown as a QR code).
# Leave empty to use the address in the browser bar.
PUBLIC_URL=
